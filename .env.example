# Supabase project URL and anon (public) key — Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Manager dashboard PIN gate — server-only, never exposed to the client.
# MANAGER_PIN: the numeric code staff enter to unlock /manager.
# MANAGER_SESSION_SECRET: signs the session cookie so it can't be forged by
# hand-editing a cookie in devtools; any long random string works.
MANAGER_PIN=
MANAGER_SESSION_SECRET=

# Kitchen board PIN gate — same idea, separate credential and signing secret
# so the two roles' sessions can never validate against each other.
KITCHEN_PIN=
KITCHEN_SESSION_SECRET=

# Supabase service-role key — Project Settings > API. Bypasses RLS completely,
# so it is server-only: it must never appear in a NEXT_PUBLIC_ variable or in
# any file the browser can fetch. Used for the OTP tables and for writing
# payment state, which the public anon key is deliberately not allowed to do.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay. key_id is designed to be public and is what the checkout widget
# loads with; key_secret signs payment verification and must stay server-side.
# webhook_secret is whatever you type when creating the webhook in the Razorpay
# dashboard — leave blank until then and payments are confirmed by verifying
# the checkout signature instead.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Phone-order OTP. Leave OTP_ENABLED=false to collect the number without
# verifying it — payment-first ordering already blocks junk orders, so this is
# safe to run without. Set to true only once a WhatsApp sender is wired up.
OTP_ENABLED=false
N8N_OTP_WEBHOOK_URL=
N8N_SHARED_SECRET=
